# Copy to `.env` and fill in. Never commit `.env`.
# Database names stay unprefixed: Vite inlines every `VITE_*` value into the
# browser bundle, so a `VITE_` connection string leaks its password.

# Required. Server-only PostgreSQL connection string. For local development,
# `npm run db:setup` fills it; see docs/development-database.md.
DATABASE_URL=

# Optional. `neon` (default, production) uses the Neon HTTP driver; `pg` uses
# node-postgres for a plain PostgreSQL server such as the local one.
DATABASE_DRIVER=

# Optional. Pooled Neon connection string. The app does not read it today.
DATABASE_URL_POOLER=

# Required in production; Better Auth reads it directly. Use any long random
# string locally. Without it, development falls back to an insecure default.
BETTER_AUTH_SECRET=
# Optional. Base URL for auth callbacks; defaults to the request origin.
BETTER_AUTH_URL=

# Required in production for password reset emails, sent through Resend.
# EMAIL_FROM is a sender on a domain that Resend verified, for example
# `JotTrade <no-reply@example.com>`. Without them, production does not send
# and logs an error; development writes the reset link to the server log.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. Google sign-in. Email/password sign-in works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Trade screenshot storage. Uploads fail without them. The key is the
# base64-encoded service account JSON.
GCP_BUCKET_NAME=
GCP_SERVICE_ACCOUNT_KEY=

# Optional. Enables the command palette "Interpret with Gemini" fallback.
# Server-side only; never expose it with a VITE_ prefix.
GEMINI_API_KEY=
